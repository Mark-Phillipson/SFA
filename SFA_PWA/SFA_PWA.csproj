<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
  <TargetFramework>net10.0</TargetFramework>
  <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <!-- Inject build date into AssemblyTitle for runtime retrieval -->
    <AssemblyTitle>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm"))</AssemblyTitle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
  <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
  <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.1" PrivateAssets="all" />
  <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SFA_RazorClassLibrary\SFA_RazorClassLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Layout\**\*.cs" />
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Services\**\*.cs" />

    <!--<RazorComponent Remove="App.razor" />-->
    <RazorComponent Remove="Layout\**\*.razor" />
    <!--<RazorComponent Remove="Pages\**\*.razor" />-->
    <RazorComponent Remove="Shared\**\*.razor" />

    <Content Remove="Layout\**\*.razor.css" />
    <Content Remove="Pages\**\*.razor.css" />
    <Content Remove="Shared\**\*.razor.css" />
  </ItemGroup>


  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>


  <ItemGroup>
    <Folder Include="wwwroot\Assets\" />
    <Folder Include="wwwroot\screenshots\" />
  </ItemGroup>

    <!-- Cross-platform MSBuild WriteLinesToFile task to update buildinfo.json before publish -->
    <PropertyGroup>
      <BuildDate>$([System.DateTime]::UtcNow.ToString("o"))</BuildDate>
      <BuildInfoJson>{"DotNetVersion": "$(TargetFramework)", "BuildDate": "$(BuildDate)"}</BuildInfoJson>
    </PropertyGroup>
    <Target Name="GenerateBuildInfo" BeforeTargets="Build">
      <WriteLinesToFile File="wwwroot/buildinfo.json" Lines="$(BuildInfoJson)" Overwrite="true" />
    </Target>

    <Target Name="CreateStableBlazorLoader" AfterTargets="Publish">
      <ItemGroup>
        <BlazorRuntimeFiles Include="$(PublishDir)wwwroot\_framework\blazor.webassembly.*.js" />
      </ItemGroup>
      <PropertyGroup>
        <_BlazorHashedFile>%(BlazorRuntimeFiles.Identity)</_BlazorHashedFile>
        <BlazorHashedFileName>$([System.IO.Path]::GetFileName('$(_BlazorHashedFile)'))</BlazorHashedFileName>
      </PropertyGroup>
      <Message Importance="High" Text="Creating stable blazor.webassembly.js loader for @(BlazorRuntimeFiles)" />
      <ItemGroup>
        <BlazorLoaderLines Include="(function(){" />
        <BlazorLoaderLines Include="    var hashed = '$(BlazorHashedFileName)';" />
        <BlazorLoaderLines Include="    var current = document.currentScript || (function(){" />
        <BlazorLoaderLines Include="        var scripts = document.getElementsByTagName('script');" />
        <BlazorLoaderLines Include="        return scripts[scripts.length-1];" />
        <BlazorLoaderLines Include="    })();" />
        <BlazorLoaderLines Include="    var s = document.createElement('script');" />
        <BlazorLoaderLines Include="    s.src = '_framework/' + hashed;" />
        <BlazorLoaderLines Include="    s.defer = true;" />
        <BlazorLoaderLines Include="    current.parentNode.insertBefore(s, current);" />
        <BlazorLoaderLines Include="})();" />
      </ItemGroup>
      <WriteLinesToFile File="$(PublishDir)wwwroot\_framework\blazor.webassembly.js" Overwrite="true" Condition=" '@(BlazorRuntimeFiles)' != '' " Lines="@(BlazorLoaderLines)" />
    </Target>

</Project>
