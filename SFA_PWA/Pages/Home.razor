@page "/"
@using SFA_PWA.Shared
@using Microsoft.JSInterop
@inject SFA_PWA.Services.NetworkStatusService NetworkStatus
@inject SFA_PWA.Services.IStaticJsonAssetLoader StaticJson
@inject SFA_PWA.Services.CalendarFeedService CalendarFeed
@implements IDisposable

<SeoHeader Title="Home - FairiesLittleHelper"
    Description="Welcome to FairiesLittleHelper, your companion for cycling events and cafe stops."
    Url="https://polite-sand-0eb4b4703.3.azurestaticapps.net/"
    ImageUrl="https://polite-sand-0eb4b4703.3.azurestaticapps.net/icon-512.png" />


@if (showSplash)
{
    <div class="splash-overlay" @onclick="HideSplash">
        <img src="sfa.png" alt="App Icon" class="splash-icon" />
    </div>
}


<h1>Welcome to the San Fairy Ann Cycling Club App!</h1>

<div style="background:#e9f7ef;border:1px solid #d4edda;padding:1em;margin-bottom:1em;border-radius:0.5em;">
    @if (followedGroups == null || !followedGroups.Any())
    {
        <div class="alert alert-info">You are not following any groups. Choose some in <a href="/settings">Settings</a>.</div>
    }
    else if (isGroupEventsLoading)
    {
        <div style="font-size:0.95em;color:#2c7a2c;">Loading upcoming rides for your followed groups...</div>
    }
    else
    {
        var allFiltered = homeFilteredGroupEvents.SelectMany(kv => kv.Value).ToList();
        if (allFiltered.Any())
        {
            TimeZoneInfo ukZone;
            try
            {
                if (OperatingSystem.IsWindows()) ukZone = TimeZoneInfo.FindSystemTimeZoneById("GMT Standard Time");
                else ukZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/London");
            }
            catch
            {
                ukZone = TimeZoneInfo.Local;
            }

            var earliestUkDate = allFiltered.Min(ev => TimeZoneInfo.ConvertTimeFromUtc(ev.Start, ukZone).Date);
            <div style="display:flex;flex-direction:column;gap:0.6em;">
                <div><strong style="font-size:1.05em;">Next ride date:</strong> @earliestUkDate.ToString("yyyy-MM-dd ddd")</div>
                <div style="font-size:0.95em;color:#165f3b;">Groups with rides on this date:</div>
                <div style="display:flex;flex-wrap:wrap;gap:1rem;">
                        @foreach (var kv in homeFilteredGroupEvents)
                        {
                            if (kv.Value != null && kv.Value.Any())
                            {
                                var ev = kv.Value.OrderBy(e => e.Start).First();
                                var local = TimeZoneInfo.ConvertTimeFromUtc(ev.Start, ukZone);
                                <div style="background:#fff;border:1px solid #cfead8;padding:0.6em;border-radius:0.5em;min-width:220px;">
                                    <div style="font-weight:bold;">@kv.Key</div>
                                    <div>@local.ToString("HH:mm") — @GetDisplayLocation(ev)</div>
                                    @if (ev.RouteLinks?.Count > 0)
                                    {
                                        <div style="margin-top:0.2em;font-size:0.85em;color:#007bff;"><a href="@ev.RouteLinks[0]" target="_blank" rel="noopener noreferrer">Route link</a></div>
                                    }
                                </div>
                            }
                        }
                </div>
            </div>
        }
        else
        {
            <div style="font-size:0.95em;color:#666;">No upcoming Wednesday or Saturday rides found for your followed groups.</div>
        }
    }
</div>




@if (isOnline)
{
    <div class="video-preview" style="margin:2em 0;text-align:center;">
        <h2>YouTube Video</h2>
        <a href="https://www.youtube.com/watch?v=Nkp0X28te-o" target="_blank" rel="noopener noreferrer"
            style="display:inline-flex;align-items:center;text-decoration:none;font-size:1.2em;">
            <span style="display:inline-block;width:32px;height:32px;margin-right:0.5em;">
                <svg viewBox="0 0 32 32" width="32" height="32" xmlns="http://www.w3.org/2000/svg">
                    <rect width="32" height="32" rx="6" fill="#FF0000" />
                    <polygon points="13,10 25,16 13,22" fill="#fff" />
                </svg>
            </span>
            Watch explanation video on YouTube
        </a>
    </div>
}

<div class="instructions">
    <h3>How to use this app:</h3>
    <ul>
        <li><b>Club Links:</b> Access club resources, WhatsApp channels (demo only), social media, and more from the
            <b>Links</b> page. Use the filter box to quickly find any link or resource.
        </li>
        <li><b>My Custom Links:</b> Add your own custom link and resources on the <b>My Custom Links</b> page.</li>
        <li><b>Groups/Settings:</b> Select which ride groups you want to follow. Your preferences are saved locally.
        </li>

        <li><b>Followed Calendars:</b> View upcoming rides for your selected groups on the <b>Followed Calendars</b>
            page.
            Choose which groups to follow in <b>Settings</b>.</li>
        <li><b>D Groups/Midweekers Start Points:</b> View the saved start points used by D Groups/Midweekers rides
            (addresses and notes).
        </li>
        <li><b>Cafe List:</b> Browse recommended cafes for your rides.</li>
        <li><b>Weather:</b> Access Kent weather links on the <b>Weather</b> page. Select a location from the BBC Weather
            dropdown, or visit the Met Office. No specific day forecasts are shown. The page features a clean UI with
            weather icons for quick access.</li>

        <li><b>WhatsApp Groups:</b> See WhatsApp group information and channel names.</li>
        <li><b>Chat Bot:</b> Ask the built‑in chat bot for help or quick information about the club and groups.</li>
    </ul>
    <p><i>Note: WhatsApp group links are for demonstration only and not yet set up for the club. This app works on
            desktop and mobile, and saves your settings locally for convenience.</i></p>
</div>


<!-- Lower followed-groups list removed — top summary is authoritative -->



<div class="install-section" style="margin:2em 0 3em;">
    <h2>Press/Touch Button to Install This App</h2>
    @if (isOnline)
    {
        <InstallPwaButton />
    }
    else
    {
        <div class="alert alert-info">
            <strong>📴 Offline</strong> - Install button is not available while offline. When Convenient Connect to the internet to install
            the app.
        </div>
    }
</div>

<div class="desktop-bottom-image">
    <img src="DGroupJune7.png" alt="DGroup June 7" />
</div>


<footer class="site-footer">
    <div>
        .NET Version: @AppVersion Last Build Date/Time @BuildDate
    </div>
</footer>

@inject IJSRuntime JS

@code {
    private bool showSplash = true;
    private bool isOnline = true;

    private string? AppVersion;
    private string? BuildDate;

    // Groups and followed group data
    private Dictionary<string, bool> selectedGroups = new();
    private List<GroupData> groups = new();
    private List<GroupData> followedGroups = new();
    private Dictionary<string, List<SFA_PWA.Services.CalendarEvent>> groupUpcomingEvents = new();
    private bool isGroupEventsLoading = false;
    // For Home we show only the single next Wed or Sat across all followed groups.
    private Dictionary<string, List<SFA_PWA.Services.CalendarEvent>> homeFilteredGroupEvents = new();

    protected override async Task OnInitializedAsync()
    {
        // Start a timer to hide splash after 1 second
        _ = HideSplashAfterDelayAsync();

        await LoadBuildInfoAsync();

        // Initialize network status - subscribe to events first to avoid race condition
        await NetworkStatus.InitializeAsync();
        NetworkStatus.OnlineStatusChanged += OnNetworkStatusChanged;
        isOnline = await NetworkStatus.IsOnlineAsync();

        // Load followed groups and their events
        await LoadFollowedGroupsAsync();

        // Register for groupPreferences change notifications from JS so Home updates when Settings saves
        try
        {
            _dotNetRef = DotNetObjectReference.Create<object>(this);
            await JS.InvokeVoidAsync("sfaRegisterGroupPrefsChanged", _dotNetRef);
        }
        catch { }
    }

    private void OnNetworkStatusChanged(object? sender, bool online)
    {
        isOnline = online;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NetworkStatus.OnlineStatusChanged -= OnNetworkStatusChanged;
        try
        {
            if (_dotNetRef != null)
            {
                JS.InvokeVoidAsync("sfaUnregisterGroupPrefsChanged", _dotNetRef);
                _dotNetRef.Dispose();
            }
        }
        catch { }
    }

    private async Task LoadBuildInfoAsync()
    {
        try
        {
            var buildInfo = await JS.InvokeAsync<BuildInfo>("fetchBuildInfo");
            AppVersion = buildInfo?.DotNetVersion ?? "Unknown";
            BuildDate = buildInfo?.BuildDate != null ? FormatDate(buildInfo.BuildDate) : "Unknown";
        }
        catch
        {
            AppVersion = "Unknown";
            BuildDate = "Unknown";
        }
        StateHasChanged();
    }

    private async Task LoadFollowedGroupsAsync()
    {
        try
        {
            groups = await StaticJson.LoadAsync<List<GroupData>>("sample-data/groups.json") ?? new List<GroupData>();
        }
        catch
        {
            groups = new List<GroupData>();
        }

        // Load user preferences from localStorage
        try
        {
            var prefsJson = await JS.InvokeAsync<string>("localStorage.getItem", "groupPreferences");
            if (!string.IsNullOrWhiteSpace(prefsJson))
            {
                selectedGroups = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, bool>>(prefsJson) ?? new Dictionary<string, bool>();
            }
        }
        catch { }

        followedGroups = groups.Where(g => selectedGroups.ContainsKey(g.Name) && selectedGroups[g.Name] && !string.IsNullOrWhiteSpace(g.CalendarUrl)).ToList();

        if (followedGroups.Any())
        {
            try
            {
                isGroupEventsLoading = true;
                var selected = followedGroups.Select(g => (g.Name, g.CalendarUrl));
                var events = await CalendarFeed.GetUpcomingWedSatForGroupsAsync(selected);
                groupUpcomingEvents = events.GroupBy(e => e.GroupName).ToDictionary(g => g.Key, g => g.ToList());

                // Compute the single earliest UK local date among all returned events, and filter per-group events to that date.
                try
                {
                    TimeZoneInfo ukZone;
                    if (OperatingSystem.IsWindows()) ukZone = TimeZoneInfo.FindSystemTimeZoneById("GMT Standard Time");
                    else ukZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/London");

                    var allEvents = groupUpcomingEvents.SelectMany(kv => kv.Value)
                        .Select(ev => new { Ev = ev, EvUk = TimeZoneInfo.ConvertTimeFromUtc(ev.Start, ukZone) })
                        .Where(x => x.Ev.Start >= DateTime.UtcNow)
                        .ToList();

                    if (allEvents.Any())
                    {
                        var earliestDate = allEvents.Min(x => x.EvUk.Date);
                        homeFilteredGroupEvents = groupUpcomingEvents.ToDictionary(
                            kv => kv.Key,
                            kv => kv.Value.Where(ev => TimeZoneInfo.ConvertTimeFromUtc(ev.Start, ukZone).Date == earliestDate).ToList()
                        );
                    }
                    else
                    {
                        homeFilteredGroupEvents = new Dictionary<string, List<SFA_PWA.Services.CalendarEvent>>();
                    }
                }
                catch
                {
                    homeFilteredGroupEvents = new Dictionary<string, List<SFA_PWA.Services.CalendarEvent>>();
                }
            }
            catch { }
            finally
            {
                isGroupEventsLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }


    private string FormatDate(string isoDate)
    {
        if (DateTime.TryParse(isoDate, out var dt))
        {
            try
            {
                // Use "GMT Standard Time" for Windows, "Europe/London" for Linux/macOS
                TimeZoneInfo ukZone;
                if (OperatingSystem.IsWindows())
                    ukZone = TimeZoneInfo.FindSystemTimeZoneById("GMT Standard Time");
                else
                    ukZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/London");
                var ukTime = TimeZoneInfo.ConvertTimeFromUtc(dt, ukZone);
                return ukTime.ToString("yyyy-MM-dd HH:mm");
            }
            catch
            {
                // Fallback to local time if timezone not found
                return dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
            }
        }
        return isoDate;
    }

    private async Task HideSplashAfterDelayAsync()
    {
        // Reduce splash delay from 5000ms (5s) to 1000ms (1s)
        await Task.Delay(1000);
        showSplash = false;
        StateHasChanged();
    }

    private void HideSplash()
    {
        showSplash = false;
    }

    private class BuildInfo
    {
        public string? DotNetVersion { get; set; }
        public string? BuildDate { get; set; }
    }

    private DotNetObjectReference<object>? _dotNetRef;

    [JSInvokable]
    public async Task NotifyGroupPreferencesChanged()
    {
        try
        {
            await LoadFollowedGroupsAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private string GetDisplayLocation(SFA_PWA.Services.CalendarEvent ev)
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(ev.Location)) return ev.Location;
            if (!string.IsNullOrWhiteSpace(ev.OriginalDescription))
            {
                var s = ev.OriginalDescription.Trim();
                return s.Length > 200 ? s.Substring(0, 200) + "..." : s;
            }
            if (!string.IsNullOrWhiteSpace(ev.Summary)) return ev.Summary;
        }
        catch { }
        return "(location not specified)";
    }
}