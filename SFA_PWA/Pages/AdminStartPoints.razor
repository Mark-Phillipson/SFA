@page "/admin-startpoints"
@using System.Net.Http.Json
@inject IJSRuntime JS
@inject BotApiHttpClient BotApi

<h3>Admin: D-Group Start Points</h3>

<div class="mb-3">
    <label>Admin API Key</label>
    <input type="password" @bind="ApiKey" class="form-control" placeholder="Enter API key" />
    <div class="mt-2">
        <button class="btn btn-primary me-2" @onclick="SaveApiKey">🔒 Save Key</button>
        <button class="btn btn-secondary" @onclick="ClearApiKey">🗑️ Clear Key</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}

@* Debug logs removed from UI *@

@if (Editing != null)
{
    <div class="card p-3 mb-3 border-primary">
        <h5 class="card-title">@(IsNew ? "Add New Start Point" : $"Edit: {Editing.Name}")</h5>
        <div class="mb-2">
            <label>Name</label>
            <input class="form-control" @bind="Editing.Name" />
        </div>
        <div class="mb-2">
            <label>Location</label>
            <input class="form-control" @bind="Editing.Location" />
        </div>
        <div class="mb-2">
            <label>Postcode</label>
            <input class="form-control" @bind="Editing.Postcode" />
        </div>
        <div class="mb-2">
            <label>Notes</label>
            <textarea class="form-control" @bind="Editing.Notes"></textarea>
        </div>
        <div>
            <button class="btn btn-primary me-2" @onclick="Save" disabled="@IsProcessing">
                @if (IsProcessing) { <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> }
                💾 Save
            </button>
            <button class="btn btn-secondary" @onclick="Cancel" disabled="@IsProcessing">✖ Cancel</button>
        </div>
    </div>
}

<button class="btn btn-success mb-3" @onclick="NewStartPoint" disabled="@IsProcessing">➕ Add New Start Point</button>

<div class="mb-2">
    <input placeholder="Search name, location or postcode..." @bind="searchTerm" @bind:event="oninput" class="form-control" />
</div>

@if (StartPoints == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Name</th><th>Location</th><th>Postcode</th><th>Actions</th></tr>
        </thead>
        <tbody>
        @foreach (var sp in FilteredStartPoints())
        {
            <tr>
                <td>@sp.Name</td>
                <td>@sp.Location</td>
                <td>@sp.Postcode</td>
                <td>
                    <button class="btn btn-sm btn-primary me-1" @onclick="() => EditStartPoint(sp)" disabled="@IsProcessing">✏️ Edit</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteStartPoint(sp.Id)" disabled="@IsProcessing">
                        @if (IsProcessing && ProcessingId == sp.Id) { <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> }
                        🗑️ Delete
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<SFA_PWA.Models.StartPoint>? StartPoints;
    private SFA_PWA.Models.StartPoint? Editing;
    private bool IsNew = false;
    private bool IsProcessing = false;
    private string? ProcessingId;
    private string ApiKey = string.Empty;
    private string? ErrorMessage;
    private string searchTerm = string.Empty;

    private void Log(string message)
    {
        // Debug logging disabled in UI; keep method as no-op to avoid breaking calls.
    }

    protected override async Task OnInitializedAsync()
    {
        Log("OnInitializedAsync started");
        await LoadApiKey();
        await Refresh();
    }

    private async Task Refresh()
    {
        ErrorMessage = null;
        try
        {
            Log($"Refreshing list from {BotApi.Client.BaseAddress}");
            // Prefer configured backend client
            var resp = await BotApi.Client.GetAsync("api/startpoints");
            if (resp.IsSuccessStatusCode)
            {
                var contentType = resp.Content.Headers.ContentType?.MediaType ?? string.Empty;
                if (contentType.Contains("json"))
                {
                    StartPoints = await resp.Content.ReadFromJsonAsync<List<SFA_PWA.Models.StartPoint>>();
                    Log($"Loaded {StartPoints?.Count ?? 0} items");
                }
                else
                {
                    var txt = await resp.Content.ReadAsStringAsync();
                    ErrorMessage = $"Expected JSON but server returned {contentType}. Response snippet: {GetSnippet(txt)}";
                    StartPoints = new List<SFA_PWA.Models.StartPoint>();
                    Log("Error: Expected JSON");
                }
            }
            else
            {
                var txt = await resp.Content.ReadAsStringAsync();
                ErrorMessage = $"Request failed: {(int)resp.StatusCode} {resp.ReasonPhrase}. Response snippet: {GetSnippet(txt)}";
                StartPoints = new List<SFA_PWA.Models.StartPoint>();
                Log($"Request failed: {resp.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Log($"Exception: {ex.Message}");
            // Fallback to same-origin (useful for static/local dev)
            try
            {
                Log($"Attempting fallback to {NavigationManager.BaseUri}");
                var fb = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
                var resp = await fb.GetAsync("api/startpoints");
                if (resp.IsSuccessStatusCode)
                {
                    var contentType = resp.Content.Headers.ContentType?.MediaType ?? string.Empty;
                    if (contentType.Contains("json"))
                    {
                        StartPoints = await resp.Content.ReadFromJsonAsync<List<SFA_PWA.Models.StartPoint>>();
                        Log($"Fallback loaded {StartPoints?.Count ?? 0} items");
                    }
                    else
                    {
                        var txt = await resp.Content.ReadAsStringAsync();
                        ErrorMessage = $"Fallback: expected JSON but server returned {contentType}. Response snippet: {GetSnippet(txt)}";
                        StartPoints = new List<SFA_PWA.Models.StartPoint>();
                    }
                }
                else
                {
                    var txt = await resp.Content.ReadAsStringAsync();
                    ErrorMessage = $"Fallback request failed: {(int)resp.StatusCode} {resp.ReasonPhrase}. Response snippet: {GetSnippet(txt)}";
                    StartPoints = new List<SFA_PWA.Models.StartPoint>();
                    Log($"Fallback failed: {resp.StatusCode}");
                }
            }
            catch (Exception ex2)
            {
                ErrorMessage = $"Error contacting API: {ex.Message}; fallback error: {ex2.Message}";
                StartPoints = new List<SFA_PWA.Models.StartPoint>();
                Log($"Fallback exception: {ex2.Message}");
            }
        }
        StateHasChanged();
    }

    private async Task LoadApiKey()
    {
        var k = await JS.InvokeAsync<string>("localStorage.getItem", "adminApiKey");
        ApiKey = k ?? string.Empty;
    }

    private async Task SaveApiKey()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "adminApiKey", ApiKey ?? string.Empty);
        Log("API Key saved");
    }

    private async Task ClearApiKey()
    {
        ApiKey = string.Empty;
        await JS.InvokeVoidAsync("localStorage.removeItem", "adminApiKey");
        Log("API Key cleared");
    }

    private void NewStartPoint()
    {
        Log("NewStartPoint clicked");
        try
        {
            Editing = new SFA_PWA.Models.StartPoint();
            IsNew = true;
            StateHasChanged(); // Ensure UI updates
        }
        catch (Exception ex)
        {
            Log($"Error in NewStartPoint: {ex.Message}");
        }
    }

    private void EditStartPoint(SFA_PWA.Models.StartPoint sp)
    {
        Log($"EditStartPoint clicked for {sp.Id}");
        try
        {
            Editing = new SFA_PWA.Models.StartPoint
            {
                Id = sp.Id,
                Name = sp.Name,
                Location = sp.Location,
                Postcode = sp.Postcode,
                Notes = sp.Notes,
                PlusCode = sp.PlusCode,
                GoogleMaps = sp.GoogleMaps,
                What3Words = sp.What3Words,
                Coordinates = sp.Coordinates != null ? new SFA_PWA.Models.Coordinates { Lat = sp.Coordinates.Lat, Lng = sp.Coordinates.Lng } : null
            };
            IsNew = false;
            StateHasChanged(); // Ensure UI updates
        }
        catch (Exception ex)
        {
            Log($"Error in EditStartPoint: {ex.Message}");
        }
    }

    private void Cancel()
    {
        Log("Cancel clicked");
        Editing = null;
    }

    private async Task Save()
    {
        Log("Save clicked");
        if (Editing == null) return;
        IsProcessing = true;
        StateHasChanged();
        try
        {
            if (IsNew)
            {
                var req = new HttpRequestMessage(HttpMethod.Post, "api/startpoints")
                {
                    Content = JsonContent.Create(Editing)
                };
                if (!string.IsNullOrEmpty(ApiKey)) req.Headers.Add("X-API-KEY", ApiKey);
                var res = await BotApi.Client.SendAsync(req);
                if (res.IsSuccessStatusCode) 
                { 
                    Log("Create success");
                    await Refresh(); 
                    Editing = null; 
                }
                else
                {
                    var txt = await res.Content.ReadAsStringAsync();
                    ErrorMessage = $"Save failed: {(int)res.StatusCode} {res.ReasonPhrase}. Response snippet: {GetSnippet(txt)}";
                    Log($"Create failed: {res.StatusCode}");
                }
            }
            else
            {
                var req = new HttpRequestMessage(HttpMethod.Put, $"api/startpoints/{Editing.Id}")
                {
                    Content = JsonContent.Create(Editing)
                };
                if (!string.IsNullOrEmpty(ApiKey)) req.Headers.Add("X-API-KEY", ApiKey);
                var res = await BotApi.Client.SendAsync(req);
                if (res.IsSuccessStatusCode) 
                { 
                    Log("Update success");
                    await Refresh(); 
                    Editing = null; 
                }
                else
                {
                    var txt = await res.Content.ReadAsStringAsync();
                    ErrorMessage = $"Update failed: {(int)res.StatusCode} {res.ReasonPhrase}. Response snippet: {GetSnippet(txt)}";
                    Log($"Update failed: {res.StatusCode}");
                }
            }
        }
        catch (Exception ex)
        {
            Log($"Save exception: {ex.Message}");
            ErrorMessage = $"Error saving: {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task DeleteStartPoint(string? id)
    {
        Log($"DeleteStartPoint clicked for {id}");
        if (string.IsNullOrEmpty(id)) 
        {
            Log("Delete aborted: ID is null or empty");
            return;
        }
        
        if (!await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this start point?"))
        {
            Log("Delete cancelled by user");
            return;
        }

        IsProcessing = true;
        ProcessingId = id;
        StateHasChanged();
        try
        {
            var req = new HttpRequestMessage(HttpMethod.Delete, $"api/startpoints/{id}");
            if (!string.IsNullOrEmpty(ApiKey)) req.Headers.Add("X-API-KEY", ApiKey);
            var res = await BotApi.Client.SendAsync(req);
            if (res.IsSuccessStatusCode) 
            {
                Log("Delete success");
                await Refresh();
            }
            else
            {
                var txt = await res.Content.ReadAsStringAsync();
                ErrorMessage = $"Delete failed: {(int)res.StatusCode} {res.ReasonPhrase}. Response snippet: {GetSnippet(txt)}";
                Log($"Delete failed: {res.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Log($"Delete exception: {ex.Message}");
            ErrorMessage = $"Error deleting: {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
            ProcessingId = null;
            StateHasChanged();
        }
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private IEnumerable<SFA_PWA.Models.StartPoint> FilteredStartPoints()
    {
        if (StartPoints == null) return Enumerable.Empty<SFA_PWA.Models.StartPoint>();
        var q = StartPoints.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim();
            q = q.Where(sp => (sp.Name ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase)
                            || (sp.Location ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase)
                            || (sp.Postcode ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return q;
    }

    private static string GetSnippet(string s, int len = 300)
    {
        if (string.IsNullOrEmpty(s)) return string.Empty;
        return s.Length <= len ? s : s.Substring(0, len) + "...";
    }
}
