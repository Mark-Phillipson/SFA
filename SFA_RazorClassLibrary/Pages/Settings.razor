@page "/settings"
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@using System.Collections.Generic
@using System.Text.RegularExpressions
<PageTitle>Groups/Settings</PageTitle>

<style>
    .view-toggle {
        display: inline-flex;
        gap: 0.5rem;
        background: #eef3f8;
        border-radius: 0.75rem;
        padding: 0.3rem;
        flex-wrap: wrap;
    }

    .view-toggle button {
        border: none;
        border-radius: 0.6rem;
        padding: 0.5rem 1rem;
        background: transparent;
        font-weight: 600;
        color: #274b66;
    }

    .view-toggle button.active {
        background: #0d6efd;
        color: #fff;
    }

    .group-table-wrapper {
        overflow-x: auto;
        margin-top: 1rem;
    }

    .group-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        box-shadow: 0 0 0 1px rgba(0,0,0,0.06);
        border-radius: 0.75rem;
        overflow: hidden;
    }

    .group-table th,
    .group-table td {
        padding: 0.75rem 0.7rem;
        border-bottom: 1px solid #edf0f2;
        vertical-align: top;
        text-align: left;
    }

    .group-table th {
        background: #f4f7fb;
        color: #1b2a3d;
        font-size: 0.9rem;
    }

    .group-table a.btn {
        display: inline-block;
        margin-right: 0.35rem;
        margin-bottom: 0.2rem;
    }

    @@media (max-width: 767px) {
        .group-table,
        .group-table thead,
        .group-table tbody,
        .group-table th,
        .group-table td,
        .group-table tr {
            display: block;
            width: 100%;
        }

        .group-table thead {
            display: none;
        }

        .group-table tr {
            background: #fff;
            margin-bottom: 0.85rem;
            border: 1px solid #e7edf3;
            border-radius: 0.85rem;
            padding: 0.5rem 0.75rem;
        }

        .group-table td {
            border: none;
            padding: 0.45rem 0;
        }

        .group-table td::before {
            content: attr(data-label);
            display: block;
            font-weight: 700;
            color: #44566a;
            margin-bottom: 0.2rem;
        }
    }
</style>

<h1>Ride Group Preferences</h1>
<p>Select which San Fairy Ann ride groups you want to follow:</p>

<h2>Calendar View Preference</h2>
<div style="margin-bottom: 1em;">
    <label for="calendarView" style="font-size: 1.1em;">Default calendar view for desktop:</label>
    <select id="calendarView" @bind="calendarView" style="margin-left:1em;font-size:1.1em;padding:0.3em 1em;">
        <option value="MONTH">Month</option>
        <option value="WEEK">Week</option>
        <option value="AGENDA">Schedule</option>
    </select>
</div>

<h2>Available Groups</h2>
<div style="margin-bottom: 1em; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:1rem;">
    <div class="view-toggle" aria-label="Group view selector">
        <button type="button" class="@(groupViewMode == "cards" ? "active" : string.Empty)" @onclick='() => groupViewMode = "cards"'>Cards</button>
        <button type="button" class="@(groupViewMode == "table" ? "active" : string.Empty)" @onclick='() => groupViewMode = "table"'>Table</button>
    </div>

    <div style="display:flex; align-items:center; gap:0.5rem;">
        <label for="sortGroups" style="font-size: 1.05em; margin:0;">Sort by:</label>
        <select id="sortGroups" @bind="sortBy" style="font-size: 1.05em; padding: 0.35rem 0.75rem;">
            <option value="time">Time</option>
            <option value="speed">Speed</option>
            <option value="distance">Distance</option>
        </select>
    </div>
</div>

<div style="margin-bottom: 1em;">
    <label style="display: flex; align-items: center; font-size: 1.1em; gap: 0.5em;">
        <input type="checkbox" style="width: 1.3em; height: 1.3em; accent-color: #007bff; margin: 0;"
               @bind="showOnlyFollowed" />
        <span>Show only followed groups</span>
    </label>
</div>

@if (groupViewMode == "cards")
{
    <div style="display: flex; flex-wrap: wrap; gap: 1.5rem;">
        @foreach (var group in SortedGroups)
        {
            <GroupEventCard Name="@group.Name" Description="@group.Description" InfoUrl="@group.InfoUrl"
                            CalendarUrl="@group.CalendarUrl"
                            MeetingPlace="@group.MeetingPlace"
                            MeetingTime="@group.MeetingTime"
                            Speed="@group.Speed"
                            Distance="@group.Distance"
                            Events="@(groupUpcomingEvents.ContainsKey(group.Name) ? groupUpcomingEvents[group.Name] : new List<SFA_RazorClassLibrary.Services.CalendarEvent>())"
                            IsSelected="@IsSelected(group.Name)" ShowCheckbox="true"
                            OnSelectionChanged="@(async (bool val) => await OnPreferenceChangedAndSave(group.Name, val))"
                            Diagnostics="@(groupDiagnostics.TryGetValue(group.Name, out var d) ? d : null)"
                            IsLoading="@isGroupEventsLoading" />
        }
    </div>
}
else
{
    <div class="group-table-wrapper">
        <table class="group-table">
            <thead>
                <tr>
                    <th>Group</th>
                    <th>Description</th>
                    <th>Meeting Place</th>
                    <th>Time</th>
                    <th>Speed</th>
                    <th>Distance</th>
                    <th>Follow</th>
                    <th>Links</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in SortedGroups)
                {
                    <tr>
                        <td data-label="Group"><strong>@group.Name</strong></td>
                        <td data-label="Description">@group.Description</td>
                        <td data-label="Meeting Place">@group.MeetingPlace</td>
                        <td data-label="Time">@group.MeetingTime</td>
                        <td data-label="Speed">@group.Speed</td>
                        <td data-label="Distance">@group.Distance</td>
                        <td data-label="Follow">
                            <input type="checkbox" checked="@IsSelected(group.Name)" @onchange="@(async (ChangeEventArgs e) => await OnPreferenceChangedAndSave(group.Name, e.Value))"
                                   style="width: 1.5em; height: 1.5em; accent-color: #007bff;" />
                        </td>
                        <td data-label="Links">
                            @if (!string.IsNullOrWhiteSpace(group.InfoUrl))
                            {
                                <a href="@group.InfoUrl" target="_blank" class="btn btn-sm btn-info">Info</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(group.CalendarUrl))
                            {
                                <a href="@group.CalendarUrl" target="_blank" class="btn btn-sm btn-success">Calendar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private Dictionary<string, bool> selectedGroups = new();
    private List<GroupData> groups = new();
    private bool showOnlyFollowed = false;
    private string groupViewMode = "cards";
    private string sortBy = "time";

    private string _calendarView = "MONTH";
    private string calendarView
    {
        get => _calendarView;
        set
        {
            if (_calendarView != value)
            {
                _calendarView = value;
                JS.InvokeVoidAsync("localStorage.setItem", "calendarViewPreference", _calendarView);
            }
        }
    }

    private IEnumerable<GroupData> FilteredGroups => showOnlyFollowed
        ? groups.Where(g => IsSelected(g.Name))
        : groups;

    private IEnumerable<GroupData> SortedGroups => ApplySorting(FilteredGroups);

    [Inject]
    private HttpClient Http { get; set; } = default!;
    [Inject]
    private IJSRuntime JS { get; set; } = default!;
    [Inject]
    private SFA_RazorClassLibrary.Services.IStaticJsonAssetLoader StaticJson { get; set; } = default!;
    [Inject]
    private SFA_RazorClassLibrary.Services.CalendarFeedService CalendarFeed { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Load all groups from groups.json
        try
        {
            groups = await StaticJson.LoadAsync<List<GroupData>>("sample-data/groups.json") ?? new List<GroupData>();
        }
        catch
        {
            groups = new List<GroupData>();
        }

        // Load user preferences from localStorage
        var prefsJson = await JS.InvokeAsync<string>("localStorage.getItem", "groupPreferences");
        if (!string.IsNullOrWhiteSpace(prefsJson))
        {
            selectedGroups = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, bool>>(prefsJson) ?? new Dictionary<string, bool>();
        }
        // Ensure all groups have a preference entry
        foreach (var group in groups)
        {
            if (!selectedGroups.ContainsKey(group.Name))
                selectedGroups[group.Name] = false;
        }

        // Set filter default: show only followed if any are followed
        showOnlyFollowed = selectedGroups.Values.Any(v => v);

        // Load calendar view preference
        var viewPref = await JS.InvokeAsync<string>("localStorage.getItem", "calendarViewPreference");
        if (!string.IsNullOrWhiteSpace(viewPref))
        {
            calendarView = viewPref;
        }
        // Load latest events for all groups on page load
        await LoadGroupEventsAsync();
    }

    private IEnumerable<GroupData> ApplySorting(IEnumerable<GroupData> items)
    {
        return sortBy switch
        {
            "speed" => items.OrderBy(g => GetComparableMetric(g.Speed)).ThenBy(g => g.Name),
            "distance" => items.OrderBy(g => GetComparableMetric(g.Distance)).ThenBy(g => g.Name),
            _ => items.OrderBy(g => GetComparableTime(g.MeetingTime)).ThenBy(g => g.Name),
        };
    }

    private static double GetComparableTime(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return double.MaxValue;

        var match = Regex.Match(value, @"(\d{1,2}):(\d{2})\s*(AM|PM)", RegexOptions.IgnoreCase);
        if (!match.Success) return double.MaxValue;

        if (!int.TryParse(match.Groups[1].Value, out var hours) ||
            !int.TryParse(match.Groups[2].Value, out var minutes))
        {
            return double.MaxValue;
        }

        var isPm = match.Groups[3].Value.Equals("PM", StringComparison.OrdinalIgnoreCase);
        if (isPm && hours < 12) hours += 12;
        if (!isPm && hours == 12) hours = 0;

        return (hours * 60d) + minutes;
    }

    private static double GetComparableMetric(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return double.MaxValue;

        var normalized = value.Trim();
        if (normalized.Contains("Varies", StringComparison.OrdinalIgnoreCase) ||
            normalized.Contains("Various", StringComparison.OrdinalIgnoreCase))
        {
            return double.MaxValue;
        }

        var numbers = Regex.Matches(normalized, @"\d+(?:\.\d+)?").Select(match => double.Parse(match.Value)).ToList();
        if (numbers.Count == 0) return double.MaxValue;

        return numbers.Average();
    }

    private async Task SavePreferences()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "groupPreferences",
            System.Text.Json.JsonSerializer.Serialize(selectedGroups));
        await JS.InvokeVoidAsync("localStorage.setItem", "calendarViewPreference", calendarView);
        try { await JS.InvokeVoidAsync("sfaNotifyGroupPrefsChanged"); } catch { }
    }

    private async Task OnPreferenceChangedAndSave(string groupName, object? value)
    {
        bool isChecked = false;
        if (value is bool b)
            isChecked = b;
        else if (value is string s && bool.TryParse(s, out var parsed))
            isChecked = parsed;
        else if (value == null)
            isChecked = false;
        selectedGroups[groupName] = isChecked;
        await SavePreferences();
        // Refresh upcoming events when preferences change
        await RefreshUpcomingEventsAsync();
    }

    private bool IsSelected(string groupName)
    {
        return selectedGroups.ContainsKey(groupName) && selectedGroups[groupName];
    }

    private void OnPreferenceChanged(string groupName, object? value)
    {
        bool isChecked = false;
        if (value is bool b)
            isChecked = b;
        else if (value is string s && bool.TryParse(s, out var parsed))
            isChecked = parsed;
        else if (value == null)
            isChecked = false;
        selectedGroups[groupName] = isChecked;
    }

    // Upcoming events
    private List<SFA_RazorClassLibrary.Services.CalendarEvent> upcomingEvents = new();
    private bool isEventsLoading = false;

    private async Task RefreshUpcomingEventsAsync()
    {
        try
        {
            isEventsLoading = true;
            StateHasChanged();

            var selected = groups.Where(g => selectedGroups.ContainsKey(g.Name) && selectedGroups[g.Name] &&
!string.IsNullOrWhiteSpace(g.CalendarUrl))
                                 .Select(g => (g.Name, g.CalendarUrl));
            if (!selected.Any())
            {
                upcomingEvents = new List<SFA_RazorClassLibrary.Services.CalendarEvent>();
                return;
            }

            upcomingEvents = await CalendarFeed.GetUpcomingWedSatForGroupsAsync(selected);
        }
        catch
        {
            upcomingEvents = new List<SFA_RazorClassLibrary.Services.CalendarEvent>();
        }
        finally
        {
            isEventsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Dictionary<string, List<SFA_RazorClassLibrary.Services.CalendarEvent>> groupUpcomingEvents = new();
    private bool isGroupEventsLoading = false;
    private Dictionary<string, string> groupDiagnostics = new();

    private async Task LoadGroupEventsAsync()
    {
        try
        {
            isGroupEventsLoading = true;
            StateHasChanged();

            var all = groups.Where(g => !string.IsNullOrWhiteSpace(g.CalendarUrl)).Select(g => (g.Name, g.CalendarUrl));
            if (!all.Any())
            {
                groupUpcomingEvents = new Dictionary<string, List<SFA_RazorClassLibrary.Services.CalendarEvent>>();
                return;
            }

            // Clear diagnostics; we'll only show a simple user-facing message if no entry is found.
            groupDiagnostics = new Dictionary<string, string>();

            var events = await CalendarFeed.GetUpcomingWedSatForGroupsAsync(all);
            groupUpcomingEvents = events.GroupBy(e => e.GroupName)
                                        .ToDictionary(g => g.Key, g => g.ToList());

            // For groups without events, set a clear user-facing message rather than debug text
            foreach (var grp in groups)
            {
                if (!groupUpcomingEvents.ContainsKey(grp.Name) || groupUpcomingEvents[grp.Name].Count == 0)
                {
                    groupDiagnostics[grp.Name] = "No entry found on the calendar.";
                }
            }
        }
        catch
        {
            groupUpcomingEvents = new Dictionary<string, List<SFA_RazorClassLibrary.Services.CalendarEvent>>();
        }
        finally
        {
            isGroupEventsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string FormatEventDate(DateTime utc)
    {
        try
        {
            TimeZoneInfo ukZone;
            if (OperatingSystem.IsWindows())
                ukZone = TimeZoneInfo.FindSystemTimeZoneById("GMT Standard Time");
            else
                ukZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/London");
            var local = TimeZoneInfo.ConvertTimeFromUtc(utc.ToUniversalTime(), ukZone);
            return local.ToString("yyyy-MM-dd ddd");
        }
        catch
        {
            return utc.ToLocalTime().ToString("yyyy-MM-dd ddd");
        }
    }

    private string GetDisplayLocation(SFA_RazorClassLibrary.Services.CalendarEvent ev)
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(ev.Location)) return ev.Location;
            if (!string.IsNullOrWhiteSpace(ev.OriginalDescription))
            {
                var s = ev.OriginalDescription.Trim();
                return s.Length > 200 ? s.Substring(0, 200) + "..." : s;
            }
            if (!string.IsNullOrWhiteSpace(ev.Summary)) return ev.Summary;
        }
        catch { }
        return "(location not specified)";
    }

}