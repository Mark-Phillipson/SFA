@page "/whatsapp-groups"
@using SFA_PWA.Shared

<PageTitle>WhatsApp Groups</PageTitle>
<h2 class="mb-4 text-center">WhatsApp Groups</h2>

<div class="container py-4">
    <div class="row row-cols-1 g-3 mb-4">
        <a href="https://chat.whatsapp.com/LerHpzKPNmj5DfbIpJRsPA?mode=hqrt1" target="_blank" rel="noopener" class="text-decoration-none">
            <WhatsAppGroupLink GroupName="Midweekers" Emoji="🚴" Description="Midweek cycling group" />
        </a>
        <a href="https://chat.whatsapp.com/JJfo5ei1RkNLRJo69jPo7y?mode=hqrt1" target="_blank" rel="noopener" class="text-decoration-none">
            <WhatsAppGroupLink GroupName="D Groups" Emoji="🚴" Description="D Group cycling" />
        </a>
        <a href="https://chat.whatsapp.com/FQKjRi7Tiaa09bQUgRJixR?mode=hqrt1" target="_blank" rel="noopener" class="text-decoration-none">
            <WhatsAppGroupLink GroupName="E Group" Emoji="🚴" Description="E Group cycling" />
        </a>
        <a href="https://www.sanfairyanncc.co.uk/virtual-riding" target="_blank" rel="noopener" class="text-decoration-none">
            <WhatsAppGroupLink GroupName="Zwift Group" Emoji="🚴" Description="Virtual Zwift riding group You will need to follow Jonathan Leeson (TST) on Zwift to be invivted." />
        </a>
    </div>

    <div class="alert alert-warning mb-4" role="alert">
        <strong>Important:</strong> To join other groups, please contact the ride coordinators directly or request access via the SFACC Community group. 
    </div>
    
    @* <div class="alert alert-info mb-4" role="alert">
        <strong>Tip:</strong> WhatsApp is available on desktop (PC and Mac) as well as mobile devices. Members can use WhatsApp on their computer for easier group communication and access.
        @if (IsDesktop)
        {
            <div class="mt-2">
                <a href="https://web.whatsapp.com/" target="_blank" rel="noopener" class="btn btn-success">
                    Open WhatsApp Web
                </a>
            </div>
        }
    </div> *@

    @code {

        
        [Inject] IJSRuntime JS { get; set; } = default!;
    }
</div>
