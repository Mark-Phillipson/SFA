@page "/chatbot"
@using SFA_RazorClassLibrary.Shared
@inject SFA_RazorClassLibrary.Services.NetworkStatusService NetworkStatus
@implements IDisposable

<PageTitle>ChatBot</PageTitle>

@inject BotApiConfig BotApiConfig

@if (!isOnline)
{
    <div class="alert alert-warning">
        <strong>📴 Offline</strong> - The Club ChatBot is not available while offline. Connect to the internet to use the chatbot.
    </div>
}
else
{
    <ChatBotComponent ApiUrl="@(BotApiConfig.BotApiUrl + "api/Bot/chat")" />
}

@code {
    private bool isOnline = true;

    protected override async Task OnInitializedAsync()
    {
        await NetworkStatus.InitializeAsync();
        NetworkStatus.OnlineStatusChanged += OnNetworkStatusChanged;
        isOnline = await NetworkStatus.IsOnlineAsync();
    }
    
    private void OnNetworkStatusChanged(object? sender, bool online)
    {
        isOnline = online;
        InvokeAsync(StateHasChanged);
    }
    
    public void Dispose()
    {
        NetworkStatus.OnlineStatusChanged -= OnNetworkStatusChanged;
    }
}
