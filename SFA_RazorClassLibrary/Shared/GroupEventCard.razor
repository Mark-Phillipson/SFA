@using SFA_RazorClassLibrary.Services
@using Microsoft.AspNetCore.Components

<div
    style="background: #f8f9fa; border-radius: 1em; box-shadow: 0 1px 4px rgba(0,0,0,0.04); padding: 1.2em; min-width: 280px; display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 0.5em;">
    <label style="display: flex; align-items: center; gap: 1em; font-size: 1.3em; width:100%;">
        @if (ShowCheckbox)
        {
            <input type="checkbox" checked="@IsSelected" @onchange="OnCheckboxChanged"
                   style="width: 2.2em; height: 2.2em; accent-color: #007bff;" />
        }
        <span style="font-weight: bold;">@Name</span>
    </label>
    <span style="margin: 0.5em 0 1em 0; font-size: 1.1em; color: #333; width:100%;">@Description</span>

    <div style="display:grid; gap:0.4em; margin-bottom: 1em; width:100%; font-size:0.98em; color:#222;">
        @if (!string.IsNullOrWhiteSpace(MeetingPlace))
        {
            <div><strong>Meet:</strong> @MeetingPlace</div>
        }
        @if (!string.IsNullOrWhiteSpace(MeetingTime))
        {
            <div><strong>Time:</strong> @MeetingTime</div>
        }
        @if (!string.IsNullOrWhiteSpace(Speed))
        {
            <div><strong>Speed:</strong> @Speed</div>
        }
        @if (!string.IsNullOrWhiteSpace(Distance))
        {
            <div><strong>Distance:</strong> @Distance</div>
        }
    </div>

    <div style="display: flex; flex-wrap: wrap; gap: 1em; margin-bottom:0.6em; width:100%;">
        <a href="@InfoUrl" target="_blank" class="btn btn-info btn-lg"
           style="font-size: 1.1em; padding: 0.6em 1.2em; border-radius: 0.7em;">@Name Info</a>
        @if (!string.IsNullOrWhiteSpace(CalendarUrl))
        {
            <a href="@CalendarUrl" target="_blank" class="btn btn-success btn-lg"
               style="font-size: 1.1em; padding: 0.6em 1.2em; border-radius: 0.7em;">@Name Calendar</a>
        }
    </div>

    @if (IsLoading)
    {
        <div class="loading-wheel">
            <div class="bike-wheel">
                <div class="spoke"></div>
                <div class="spoke spoke-2"></div>
                <div class="spoke spoke-3"></div>
                <div class="spoke spoke-4"></div>
            </div>

            <span>Loading Next Event...</span>
        </div>
    }
    else if (Events != null && Events.Any())
    {
        <div style="margin:0.4em 0 0.8em 0;width:100%;">
            <strong style="font-size:0.95em;">Upcoming:</strong>
            <div style="margin-top:0.4em;display:flex;flex-direction:column;gap:0.4em;">
                @foreach (var ev in Events.Take(3))
                {
                    var displayLinks = GetDisplayLinks(ev);
                    <div style="font-size:0.95em;color:#222;">
                        <div><strong>@FormatEventDate(ev.Start)</strong> @ev.Start.ToLocalTime().ToString("HH:mm")</div>
                        <div style="color:#444; white-space: pre-line;">@GetDisplayLocation(ev)</div>
                        @if (displayLinks.Count > 0)
                        {
                            @foreach (var link in displayLinks)
                            {
                                <div style="margin-top:0.2em;font-size:0.85em;color:#007bff;"><a href="@link.Url"
                                                                                                     target="_blank" rel="noopener noreferrer">@link.Text</a></div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        if (!string.IsNullOrWhiteSpace(Diagnostics))
        {
            <div style="font-size:0.95em;color:#666;margin-bottom:0.6em;">@Diagnostics</div>
        }
        else
        {
            <div style="font-size:0.95em;color:#666;margin-bottom:0.6em;">No upcoming Wednesday or Saturday rides found.</div>
        }
    }

</div>

@code {
    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public string InfoUrl { get; set; } = string.Empty;

    [Parameter]
    public string CalendarUrl { get; set; } = string.Empty;

    [Parameter]
    public string MeetingPlace { get; set; } = string.Empty;

    [Parameter]
    public string MeetingTime { get; set; } = string.Empty;

    [Parameter]
    public string Speed { get; set; } = string.Empty;

    [Parameter]
    public string Distance { get; set; } = string.Empty;

    [Parameter]
    public List<CalendarEvent>? Events { get; set; }

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public bool ShowCheckbox { get; set; } = false;

    [Parameter]
    public EventCallback<bool> OnSelectionChanged { get; set; }

    [Parameter]
    public string? Diagnostics { get; set; }

    [Parameter]
    public bool IsLoading { get; set; } = false;

    private async Task OnCheckboxChanged(ChangeEventArgs e)
    {
        bool isChecked = false;
        if (e.Value is bool b) isChecked = b;
        else if (e.Value is string s && bool.TryParse(s, out var p)) isChecked = p;
        IsSelected = isChecked;
        if (OnSelectionChanged.HasDelegate)
        {
            await OnSelectionChanged.InvokeAsync(isChecked);
        }
    }

    private string FormatEventDate(DateTime utc)
    {
        try
        {
            TimeZoneInfo ukZone;
            if (OperatingSystem.IsWindows())
                ukZone = TimeZoneInfo.FindSystemTimeZoneById("GMT Standard Time");
            else
                ukZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/London");
            var local = TimeZoneInfo.ConvertTimeFromUtc(utc.ToUniversalTime(), ukZone);
            return local.ToString("yyyy-MM-dd ddd");
        }
        catch
        {
            return utc.ToLocalTime().ToString("yyyy-MM-dd ddd");
        }
    }

    private string GetDisplayLocation(CalendarEvent ev)
    {
        try
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(ev.Summary))
            {
                parts.Add(ev.Summary.Trim());
            }
            if (!string.IsNullOrWhiteSpace(ev.Location))
            {
                var location = ev.Location.Trim();
                if (!parts.Any(p => p.Contains(location, StringComparison.OrdinalIgnoreCase)))
                    parts.Add(location);
            }
            if (!string.IsNullOrWhiteSpace(ev.OriginalDescription))
            {
                foreach (var line in ev.OriginalDescription.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    if (IsUrlOnlyLine(line))
                        continue;
                    if (line.Equals("Route:", StringComparison.OrdinalIgnoreCase))
                        continue;
                    if (!parts.Any(p => p.Contains(line, StringComparison.OrdinalIgnoreCase)))
                        parts.Add(line);
                }
            }

            if (parts.Count > 0) return string.Join(Environment.NewLine, parts);
        }
        catch { }
        return "(details not specified)";
    }

    private static bool IsUrlOnlyLine(string line)
    {
        if (!Uri.TryCreate(line.Trim(), UriKind.Absolute, out var uri))
            return false;

        return uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps;
    }

    private sealed record DisplayLink(string Url, string Text);

    private static List<DisplayLink> GetDisplayLinks(CalendarEvent ev)
    {
        var links = new List<string>();

        foreach (var link in ev.RouteLinks ?? Enumerable.Empty<string>())
        {
            if (string.IsNullOrWhiteSpace(link))
                continue;

            var trimmed = link.Trim();
            if (!Uri.TryCreate(trimmed, UriKind.Absolute, out var uri))
                continue;

            if (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps)
                continue;

            if (!links.Contains(trimmed, StringComparer.OrdinalIgnoreCase))
                links.Add(trimmed);
        }

        var display = new List<DisplayLink>();

        foreach (var link in links)
        {
            var text = GetDisplayLinkText(ev, link);
            display.Add(new DisplayLink(link, text));
        }

        return display;
    }

    private static string GetDisplayLinkText(CalendarEvent ev, string link)
    {
        if (ev.LinkTitles.TryGetValue(link, out var title) && !string.IsNullOrWhiteSpace(title))
            return title.Trim();

        return Truncate(link, 60);
    }

    private static string Truncate(string value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length <= maxLength)
            return value;

        return $"{value[..(maxLength - 3)]}...";
    }
}
