
@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
                <span class="cycling-emojis" style="font-size:2.2rem; line-height:1; vertical-align:middle;">
                    <span class="emoji-allx">San Fairy Ann 🚴‍♀️ Club</span>
                </span>
                <span style="margin-left: 1rem;"></span>
                <div class="top-links">
                    <a href="about-blazor">About</a>
                </div>
        </div>
        <OfflineIndicator />
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private async Task HardRefresh()
    {
        await JS.InvokeVoidAsync("hardRefresh");
    }
}
