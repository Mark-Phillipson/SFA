@inject SFA_PWA.Services.NetworkStatusService NetworkStatus
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
    <a class="navbar-brand" href="">Fairies Little Helper</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
                <NavLink class="nav-link nav-link-center" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu icon-center" aria-hidden="true"></span>
                    <span class="nav-text">Home</span>
                </NavLink>
        </div>
        <div class="nav-item px-3">
                <NavLink class="nav-link nav-link-center" href="links">
                    <span class="bi bi-people-fill icon-center" aria-hidden="true"></span>
                    <span class="nav-text">Club Links</span>
                </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link nav-link-center" href="custom-links">
                <span class="bi bi-link-45deg icon-center" aria-hidden="true"></span>
                <span class="nav-text">My Custom Links</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
                <NavLink class="nav-link nav-link-center" href="settings">
                    <span class="bi bi-sliders icon-center" aria-hidden="true"></span>
                    <span class="nav-text">Groups/Settings</span>
                </NavLink>
        </div>
        <div class="nav-item px-3">
                <NavLink class="nav-link nav-link-center" href="calendars">
                    <span class="bi bi-calendar-event icon-center" aria-hidden="true"></span>
                    <span class="nav-text">Followed Calendars</span>
                </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link nav-link-center" href="d-group-start-points">
                <span class="bi bi-geo-alt-fill icon-center" aria-hidden="true"></span>
                <span class="nav-text">Start Points (D/Mid)</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link nav-link-center" href="cafelist">
                <span class="bi bi-cup-straw icon-center" aria-hidden="true"></span>
                <span class="nav-text">Cafe List</span>
            </NavLink>
        </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link nav-link-center" href="weather">
            <span class="bi bi-cloud-sun icon-center" aria-hidden="true"></span>
            <span class="nav-text">Weather</span>
        </NavLink>
    </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link nav-link-center" href="whatsapp-groups">
                <span class="bi bi-whatsapp icon-center" aria-hidden="true"></span>
                <span class="nav-text">WhatsApp Groups</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link nav-link-center" href="chatbot">
                <span class="bi bi-chat-dots-fill icon-center" aria-hidden="true"></span>
                <span class="nav-text">Club ChatBot</span>
            </NavLink>
        </div>
        @if (isOnline)
        {
            <div class="nav-item px-3 hide-on-mobile">
                <NavLink class="nav-link nav-link-center" href="admin-startpoints">
                    <span class="bi bi-gear-fill icon-center" aria-hidden="true"></span>
                    <span class="nav-text">Admin</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link nav-link-center" href="javascript:void(0)" @onclick="HardRefresh" title="Refresh the app" style="cursor: pointer;">
                    <span class="bi bi-arrow-repeat icon-center" aria-hidden="true"></span>
                    <span class="nav-text">Refresh App</span>
                </NavLink>
            </div>
        }
        
    </nav>
    <div class="nav-logo" style="display: flex; justify-content: center; align-items: center; width: 100%;">
        <img src="sfa.png" alt="SFA Logo" />
    </div>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool isOnline = true;
    private DotNetObjectReference<NavMenu>? dotNetRef;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        await NetworkStatus.InitializeAsync();
        NetworkStatus.OnlineStatusChanged += OnNetworkStatusChanged;
        isOnline = await NetworkStatus.IsOnlineAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                // Initialize menu state based on screen size/orientation
                var isSmallPortrait = await JS.InvokeAsync<bool>("navMenu.isSmallPhonePortrait");
                collapseNavMenu = !isSmallPortrait;

                // Register resize/orientation callback so menu updates automatically
                await JS.InvokeVoidAsync("navMenu.registerNavMenuResizeCallback", dotNetRef);

                await InvokeAsync(StateHasChanged);
            }
            catch (Exception)
            {
                // If JS isn't available for some reason, ignore and keep default behavior
            }
        }
    }

    [JSInvokable]
    public Task UpdateMenuForScreen(bool isSmallPortrait)
    {
        collapseNavMenu = !isSmallPortrait;
        return InvokeAsync(StateHasChanged);
    }

    private void OnNetworkStatusChanged(object? sender, bool online)
    {
        isOnline = online;
        InvokeAsync(StateHasChanged);
    }
    
    public void Dispose()
    {
        try
        {
            // Fire-and-forget unregister (Dispose can't be async)
            JS.InvokeVoidAsync("navMenu.unregisterNavMenuResizeCallback");
        }
        catch { }

        dotNetRef?.Dispose();
        NetworkStatus.OnlineStatusChanged -= OnNetworkStatusChanged;
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private async Task HardRefresh()
    {
        await JS.InvokeVoidAsync("hardRefresh");
    }
}
